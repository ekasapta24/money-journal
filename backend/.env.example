# Server
PORT=5000

# Database (MySQL dari XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=money_journal

# JWT
JWT_SECRET=ganti_dengan_secret_key_yang_aman

# AWS S3
# Untuk development pakai LocalStack, untuk production pakai AWS asli
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET=money-journal-receipts
AWS_S3_ENDPOINT=http://localhost:4566

# Set ke "production" saat pakai AWS asli (menghapus AWS_S3_ENDPOINT override)
NODE_ENV=development
